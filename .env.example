# Copy this file to .env.local and fill in real values. Never commit the
# actual .env.local file — it is already in .gitignore.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_, never sent
# to the browser. Used only by the WhatsApp webhook handler and the reminder
# send route's delivery-attempt bookkeeping. See lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (optional — ledger extraction + reminder drafting) ------
# Without this, ledger extraction falls back to manual entry, and reminder
# drafting falls back to a non-AI template. Both are clearly labelled in the
# UI either way. Get a free-tier key at https://aistudio.google.com/apikey
# Note: Gemini's free tier allows Google to use your prompts/responses to
# improve their products; the paid tier does not. This app sends photographed
# ledger pages (customer names, amounts) through this key — worth knowing for
# a bookkeeping product before you pick free vs. paid.
GEMINI_API_KEY=

# --- Meta WhatsApp Business Platform Cloud API (optional) ------------------
# Without these, reminder "sending" runs in demo mode (clearly labelled,
# never claims real delivery). See SETUP.md for how to obtain each value.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: name of an approved message template to use for business-
# initiated sends (recommended — see SETUP.md for why). If unset, reminders
# send as plain session messages, which only work within an active
# customer-initiated 24h window.
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en
